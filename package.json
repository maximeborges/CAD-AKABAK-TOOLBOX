{
  "name": "cad-akabak-toolbox",
  "version": "3.0.1",
  "description": "Toolbox for CAD & AKBAk",
  "author": "SZSLAB",
  "main": "src/main.js",
  "desktopName": "cad-akabak-toolbox.desktop",
  "scripts": {
    "start": "electron .",
    "build": "electron-builder",
    "build:win": "electron-builder --win",
    "build:mac": "electron-builder --mac",
    "build:linux": "electron-builder --linux",
    "version:manager": "node docs/version-manager.js",
    "version:update": "node docs/version-manager.js update",
    "version:tag": "node docs/version-manager.js tag",
    "version:changelog": "node docs/version-manager.js changelog",
    "version:current": "node docs/version-manager.js current"
  },
  "devDependencies": {
    "autoprefixer": "^10.4.21",
    "electron": "^41.3.0",
    "electron-builder": "^26.0.12",
    "postcss": "^8.5.6",
    "tailwindcss": "^3.4.18"
  },
  "dependencies": {
    "axios": "^1.12.2",
    "builder": "^5.0.0",
    "chart.js": "^4.5.1",
    "electron-store": "^8.2.0",
    "glob": "^11.0.3",
    "tesseract.js": "^6.0.1",
    "three": "^0.180.0"
  },
  "build": {
    "appId": "com.SZSLAB.cad-akabak-toolbox",
    "productName": "CAD-Akabak Toolbox",
    "files": [
      "src/**/*",
      "node_modules/**/*"
    ],
    "asar": true,
    "extraResources": [
      {
        "from": "scripts/foam",
        "to": "foam",
        "filter": [
          "**/*.sh"
        ]
      }
    ],
    "directories": {
      "buildResources": "build",
      "output": "dist"
    },
    "artifactName": "CAD-Akabak-Toolbox-${version}-${os}-${arch}.${ext}",
    "publish": [
      {
        "provider": "github",
        "releaseType": "release"
      }
    ],
    "win": {
      "target": [
        {
          "target": "nsis",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.ico"
    },
    "nsis": {
      "oneClick": false,
      "allowToChangeInstallationDirectory": true
    },
    "mac": {
      "target": [
        {
          "target": "dmg",
          "arch": [
            "x64",
            "arm64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "public.app-category.graphics-design"
    },
    "linux": {
      "target": [
        {
          "target": "AppImage",
          "arch": [
            "x64"
          ]
        }
      ],
      "icon": "build/icon.png",
      "category": "Graphics",
      "synopsis": "Toolbox for CAD & AKABAK",
      "syncDesktopName": true
    }
  }
}
